# Local development
NODE_ENV=development
DEV_IDENTITY_SUBJECT=developer
DEV_IDENTITY_USER_ID=00000000-0000-0000-0000-000000000001
DEV_IDENTITY_EMAIL=developer@pngtourism.local
DEV_IDENTITY_ROLES=platform_admin

# API security (required in production)
AUTH_JWT_SECRET=
REQUEST_BODY_MAX_BYTES=1048576
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# Persistence
DATABASE_URL=postgres://user:password@localhost:5432/png_tourism
