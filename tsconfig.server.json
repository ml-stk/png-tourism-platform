{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist-server",
    "rootDir": "src",
    "noEmit": false
  },
  "include": ["src/server/**/*.ts", "src/persistence/**/*.ts", "src/services/**/*.ts", "src/domain/**/*.ts", "src/auth/**/*.ts"]
}
