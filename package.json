{
  "name": "png-tourism-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:server": "tsc -p tsconfig.server.json && node scripts/build-server.mjs",
    "test": "vitest run",
    "preview": "vite preview",
    "start:api": "node dist-server/server/index.js",
    "db:migrate": "node scripts/migrate.mjs",
    "db:reconcile": "node scripts/reconcile-migrations.mjs",
    "db:contract:local": "node scripts/capture-local-schema-contract.mjs",
    "test:migrations:local": "node scripts/check-local-migrations.mjs",
    "test:native:local": "node scripts/check-native-local.mjs",
    "test:release": "node scripts/release-check.mjs",
    "backup": "node scripts/database-backup.mjs",
    "test:recovery": "node scripts/recovery-check.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.1",
    "lucide-react": "1.48.0",
    "pg": "8.23.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-postgis": "0.2.8",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "pgsql-parser": "18.2.8",
    "vitest": "5.0.2"
  }
}
